{
  "manifest_version": 3,
  "name": "Mitch Browser Bridge",
  "version": "1.2.0",
  "description": "Connects browser tabs and optional page controls to your local Mitch desktop app.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Mitch Browser Bridge",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:22133"
  }
}
